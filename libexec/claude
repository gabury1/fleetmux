#!/usr/bin/env bash
# fmux claude wrapper — injects the fmux hook via --settings only into claude launched inside tmux (leaves the global config untouched)
# cmux's PATH shim pattern. Delete this file and the intervention disappears entirely.
# Finding the real binary: exclude only itself, exactly.
#   It used to exclude any path containing the substring 'libexec/tt' — but if the real claude
#   happened to be installed under such a path, it would go entirely unfound and die with
#   exit 127. Now it resolves symlinks and compares for identity instead.
SELF=$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "$0")
REAL=""
while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    [ "$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")" = "$SELF" ] && continue
    REAL="$cand"; break
done < <(type -ap claude 2>/dev/null)
[ -n "$REAL" ] || { echo "fmux-wrapper: real claude not found in PATH" >&2; exit 127; }

# Outside tmux, or the user already passed --settings, or fmux is missing → pass through transparently
if [ -z "${TMUX:-}" ] || ! command -v fmux >/dev/null 2>&1 || printf '%s\n' "$@" | grep -qx -- '--settings'; then
    exec "$REAL" "$@"
fi
exec "$REAL" --settings "$(fmux --hooks-json)" "$@"
