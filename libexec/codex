#!/usr/bin/env bash
# fmux codex wrapper — injects the fmux hook via -c only into codex launched inside tmux (leaves the global ~/.codex/config.toml untouched)
# A PATH shim isomorphic to the claude wrapper. Delete this file and the intervention disappears entirely.
# Excluding itself = avoids infinite recursion. Excluding by the 'libexec/tt' substring would
# wrongly exclude the real binary if its path contained that string, dying with exit 127 — so
# it excludes only by identity, comparing symlink-resolved absolute paths.
SELF=$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || printf '%s' "$0")
REAL=""
while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    [ "$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")" = "$SELF" ] && continue
    REAL="$cand"; break
done < <(type -ap codex 2>/dev/null)
[ -n "$REAL" ] || { echo "fmux-wrapper: real codex not found in PATH" >&2; exit 127; }

# Outside tmux, or fmux is missing → pass through transparently
if [ -z "${TMUX:-}" ] || ! command -v fmux >/dev/null 2>&1; then
    exec "$REAL" "$@"
fi

# If the user already specified hooks/trust directly → pass through untouched
# Also pass through non-interactive subcommands where hooks don't fire (codex exec, etc.) —
# so we don't misclassify the session as an agent
prev=""
for a in "$@"; do
    case "$a" in
        --dangerously-bypass-hook-trust|-chooks*|--config=hooks*) exec "$REAL" "$@" ;;
        --version|-V|--help|-h) exec "$REAL" "$@" ;;   # flags that just print and exit — avoid session misclassification
        exec|e|review|login|logout|mcp|plugin|mcp-server|app-server|remote-control|completion|update|doctor|sandbox|debug|apply|a|archive|unarchive|cloud|exec-server|features|help)
            case "$prev" in -*) ;; *) exec "$REAL" "$@" ;; esac ;;
    esac
    case "$prev" in
        -c|--config) case "$a" in hooks*) exec "$REAL" "$@" ;; esac ;;
    esac
    prev="$a"
done

# Hook args arrive one per line — read into an array and pass through as-is (no eval = zero shell injection surface)
FMUX_HOOK_ARGS=()
while IFS= read -r line; do FMUX_HOOK_ARGS+=("$line"); done < <(fmux --codex-hooks 2>/dev/null)
[ ${#FMUX_HOOK_ARGS[@]} -gt 0 ] || exec "$REAL" "$@"

# Boot self-report: codex's SessionStart only fires once the first prompt is submitted, so the
# wrapper fills in the gap at launch time
# (fmux --hook inherits the wrapper's $TMUX_PANE here, so it knows its own session)
fmux --hook boot </dev/null >/dev/null 2>&1 || true

# Unmanaged (-c injected) hooks require trust approval → the bypass flag must be included
exec "$REAL" --dangerously-bypass-hook-trust "${FMUX_HOOK_ARGS[@]}" "$@"
